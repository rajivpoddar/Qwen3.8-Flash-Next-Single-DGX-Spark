 vllm/v1/core/single_type_kv_cache_manager.py | 25 ++++--
 2 files changed, 106 insertions(+), 5 deletions(-)

diff --git a/tests/v1/core/test_prefix_caching.py b/tests/v1/core/test_prefix_caching.py
